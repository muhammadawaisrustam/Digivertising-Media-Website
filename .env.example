# Copy this file to .env.local and fill in values. Never commit .env.local.
# Only NEXT_PUBLIC_ variables are visible in the browser. Never put secrets in them.

# Public site address (used for canonical URLs, sitemap and social previews).
# Leave as localhost until a domain is confirmed.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional: Google Search Console HTML-tag verification code (the content value only).
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# --- Studio login (temporary, until Supabase accounts in Phase 3) ---
# Server-only. Pick your own long values; see docs/editor.md for how to generate them.
# STUDIO_PASSWORD must be at least 12 characters, SESSION_SECRET at least 32.
STUDIO_PASSWORD=
SESSION_SECRET=

# --- Storage ---
# Folder for local page drafts and enquiries (default: .data in the project, git-ignored).
# Not persistent on serverless hosting: Supabase replaces it before deployment.
# DATA_DIR=

# --- AI provider ---
# Leave empty: AI suggestions show "Not configured" until a free hosted provider is chosen.
# AI_PROVIDER=mock is ONLY for automated tests (fixed "[TEST]" output, not real AI).
# AI_PROVIDER=

# --- Automated tests only (leave unset on a real site) ---
# FORM_RATE_LIMIT=     form submissions per IP per 10 minutes (default 5)
# LOGIN_RATE_LIMIT=    studio login attempts per IP per 15 minutes (default 5)

# --- Added in later phases (do not fill in yet) ---
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=        (server only, never NEXT_PUBLIC_)
# AI provider keys                  (server only, never NEXT_PUBLIC_)
